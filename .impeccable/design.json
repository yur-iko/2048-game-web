  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A compact primary action with semantic colors for both themes.",
      "html": "<button class=\"ds-button\" type=\"button\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 10a8 8 0 1 1 1.4 7M4 4v6h6\"/></svg><span>New Game</span></button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;border:0;border-radius:8px;background:var(--button-bg,#252a25);color:var(--button-text,#fffdf6);font-size:12px;font-weight:700;padding:12px 17px;cursor:pointer;transition:background-color 160ms,transform 160ms cubic-bezier(.19,1,.22,1);font-family:Manrope,sans-serif;}.ds-button:hover{background:var(--button-hover,#424c39)}.ds-button:active{transform:translateY(1px)}.ds-button:focus-visible{outline:3px solid var(--focus,#566b24);outline-offset:5px}.ds-button:disabled{opacity:.5;cursor:default}.ds-button svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
    },
    {
      "name": "Secondary overlay action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Tonal companion to the primary action inside an end-state overlay.",
      "html": "<button class=\"ds-button ds-secondary\" type=\"button\">New Game</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;border:0;border-radius:8px;background:var(--button-bg,#252a25);color:var(--button-text,#fffdf6);font-size:12px;font-weight:700;padding:12px 17px;cursor:pointer;transition:background-color 160ms,transform 160ms cubic-bezier(.19,1,.22,1);font-family:Manrope,sans-serif;}.ds-button:hover{background:var(--button-hover,#424c39)}.ds-button:active{transform:translateY(1px)}.ds-button:focus-visible{outline:3px solid var(--focus,#566b24);outline-offset:5px}.ds-button:disabled{opacity:.5;cursor:default}.ds-button svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-secondary{min-height:48px;background:var(--secondary-surface,#e0e5d3);color:var(--ink,#252a25)}.ds-secondary:hover{background:var(--secondary-hover,#ccd8b0)}"
    },
    {
      "name": "Directional control",
      "kind": "button",
      "refersTo": "direction-button",
      "description": "Square native control with an inline SVG, citrus pressed state, and visible focus.",
      "html": "<button class=\"ds-direction\" type=\"button\" aria-label=\"Move left\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m14 6-6 6 6 6\"/></svg></button>",
      "css": ".ds-direction{display:grid;place-items:center;width:44px;height:44px;border-radius:8px;border:1px solid var(--direction-border,#ccd1bf);color:var(--direction-ink,#515d43);background:transparent;cursor:pointer;transition:background-color 140ms;font-family:Manrope,sans-serif;}.ds-direction:hover{background:var(--best-surface,#e1e8ca)}.ds-direction:active{background:var(--citrus,#deee90)}.ds-direction:focus-visible{outline:3px solid var(--focus,#566b24);outline-offset:5px}.ds-direction svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}@media(prefers-reduced-motion:reduce){.ds-direction{transition:none}}.ds-direction:active{color:var(--tile-ink,#252a25)}"
    },
    {
      "name": "Score containers",
      "kind": "card",
      "refersTo": "score-card",
      "description": "Standard and best score surfaces with uppercase labels, tabular numbers, and the compact score treatment.",
      "html": "<div class=\"ds-scores\"><div class=\"ds-score\"><span class=\"ds-label\">Score</span><span class=\"ds-value\">452</span></div><div class=\"ds-score ds-best\"><span class=\"ds-label\">Best</span><span class=\"ds-value\">452</span></div></div>",
      "css": ".ds-scores{display:flex;gap:9px;font-family:Manrope,sans-serif;}.ds-score{display:flex;flex-direction:column;justify-content:center;min-width:94px;min-height:70px;padding:10px 15px 9px;border-radius:10px;background:var(--score-surface,#e8e9de);color:var(--ink,#252a25)}.ds-best{background:var(--best-surface,#e1e8ca)}.ds-label{font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--score-label,#51594a)}.ds-value{font-size:24px;font-weight:800;line-height:1.4;font-variant-numeric:tabular-nums;letter-spacing:-.02em}.ds-value.ds-compact{font-size:14px;overflow-wrap:anywhere}@media(max-width:780px){.ds-score{min-width:88px;min-height:64px;padding:8px 13px}.ds-value{font-size:22px}}@media(max-width:400px){.ds-score{min-width:74px;padding:8px 6px}.ds-scores{gap:7px}.ds-value{font-size:20px}}"
    },
    {
      "name": "Progressive tile swatches",
      "kind": "custom",
      "refersTo": "tile-swatch",
      "description": "The actual power-of-two palette with visible values and digit-count sizing.",
      "html": "<div class=\"ds-swatches\"><span class=\"ds-swatch ds-v2\">2</span><span class=\"ds-swatch ds-v4\">4</span><span class=\"ds-swatch ds-v8\">8</span><span class=\"ds-swatch ds-v16\">16</span><span class=\"ds-swatch ds-v32\">32</span><span class=\"ds-swatch ds-v64\">64</span><span class=\"ds-swatch ds-v128\">128</span><span class=\"ds-swatch ds-v256\">256</span><span class=\"ds-swatch ds-v512\">512</span><span class=\"ds-swatch ds-v1024\">1024</span><span class=\"ds-swatch ds-v2048\">2048</span></div>",
      "css": ".ds-swatches{display:flex;flex-wrap:wrap;gap:12px;font-family:Manrope,sans-serif;}.ds-swatch{width:96px;height:96px;display:grid;place-items:center;border-radius:9px;font-size:43px;font-weight:800;letter-spacing:-.035em;font-variant-numeric:tabular-nums;color:var(--tile-ink,#252a25)}.ds-v2{background:#e4e8da;}.ds-v4{background:#cbd9ad;}.ds-v8{background:#deeb91;}.ds-v16{background:#efd982;}.ds-v32{background:#edbb7c;}.ds-v64{background:#e99b7c;}.ds-v128{background:#d98781;font-size:35px;}.ds-v256{background:#c8abd1;font-size:35px;}.ds-v512{background:#adbde3;font-size:35px;}.ds-v1024{background:#88b4ad;font-size:28px;}.ds-v2048{background:#344a2a;font-size:28px;color:#f1f5b0;}"
    },
    {
      "name": "Square working board",
      "kind": "custom",
      "refersTo": "game-board",
      "description": "Representative saved-game arrangement demonstrating the solid four-by-four surface. Live movement is implemented by app.js.",
      "html": "<div class=\"ds-board\" tabindex=\"0\" role=\"group\" aria-label=\"Example 2048 board\"><span class=\"ds-cell\"></span><span class=\"ds-cell\"></span><span class=\"ds-cell\"></span><span class=\"ds-cell\"></span><span class=\"ds-cell\"></span><span class=\"ds-cell\"></span><span class=\"ds-cell\"></span><span class=\"ds-cell ds-v8\">8</span><span class=\"ds-cell\"></span><span class=\"ds-cell ds-v2\">2</span><span class=\"ds-cell ds-v4\">4</span><span class=\"ds-cell ds-v32\">32</span><span class=\"ds-cell ds-v2\">2</span><span class=\"ds-cell ds-v4\">4</span><span class=\"ds-cell ds-v64\">64</span><span class=\"ds-cell ds-v4\">4</span></div>",
      "css": ".ds-board{width:min(100%,468px);aspect-ratio:1;display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(4,1fr);gap:var(--gap,12px);padding:var(--gap,12px);border-radius:var(--radius,16px);background:var(--board,#d7dacd);font-family:Manrope,sans-serif;}.ds-board:focus-visible{outline:3px solid var(--focus,#566b24);outline-offset:5px}.ds-cell{display:grid;place-items:center;min-width:0;border-radius:9px;background:var(--cell,#e8eade);color:var(--tile-ink,#252a25);font-size:43px;font-weight:800;letter-spacing:-.035em;font-variant-numeric:tabular-nums}.ds-board .ds-v2{background:#e4e8da}.ds-board .ds-v4{background:#cbd9ad}.ds-board .ds-v8{background:#deeb91}.ds-board .ds-v32{background:#edbb7c}.ds-board .ds-v64{background:#e99b7c}@media(max-width:1040px){.ds-cell{font-size:39px}}@media(max-width:400px){.ds-board{gap:9px;padding:9px;border-radius:13px}.ds-cell{font-size:32px;border-radius:7px}}"
    },
    {
      "name": "Ruled header navigation",
      "kind": "nav",
      "description": "Square brand geometry paired with a 44px light/dark action button; the next mode is named in its accessible label.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Game\"><a class=\"ds-brand\" href=\"#\"><svg class=\"ds-brand-mark\" viewBox=\"0 0 28 28\" aria-hidden=\"true\"><rect x=\"1\" y=\"1\" width=\"11\" height=\"11\" rx=\"2\"/><rect x=\"16\" y=\"1\" width=\"11\" height=\"11\" rx=\"2\"/><rect x=\"1\" y=\"16\" width=\"11\" height=\"11\" rx=\"2\"/><rect x=\"16\" y=\"16\" width=\"11\" height=\"11\" rx=\"2\"/></svg><span>the number puzzle</span></a><button class=\"ds-theme\" type=\"button\" aria-label=\"Switch to dark mode\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z\"/></svg><span>Dark mode</span></button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:112px;border-bottom:1px solid var(--line,#d9d9cc);color:var(--ink,#252a25);font-family:Manrope,sans-serif;}.ds-nav a{color:inherit;text-decoration:none;font-size:13px;font-weight:700}.ds-brand{display:inline-flex;align-items:center;gap:12px}.ds-brand-mark{width:25px;height:25px;fill:currentColor}.ds-brand-mark rect:last-child{fill:#778a44}.ds-nav a:focus-visible{outline:3px solid var(--focus,#566b24);outline-offset:5px}@media(max-width:780px){.ds-nav{min-height:76px;gap:16px}.ds-nav a{font-size:12px}.ds-brand{gap:9px}.ds-brand-mark{width:21px;height:21px}}.ds-theme{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:8px 12px;border:1px solid var(--line,#d9d9cc);border-radius:8px;background:transparent;color:var(--ink,#252a25);font:700 13px Manrope,sans-serif}.ds-theme:hover{background:var(--score-surface,#e8e9de)}.ds-theme:focus-visible{outline:3px solid var(--focus,#566b24);outline-offset:5px}.ds-theme svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}@media(max-width:780px){.ds-theme{font-size:12px;padding:8px 10px;gap:7px}}"
    },
    {
      "name": "End-state overlay",
      "kind": "custom",
      "refersTo": "game-overlay",
      "description": "Paper overlay with milestone swatch, clear status, and familiar actions.",
      "html": "<section class=\"ds-overlay\" aria-labelledby=\"ds-overlay-title\"><div><span class=\"ds-milestone\">2048</span><h2 id=\"ds-overlay-title\">You made it.</h2><p>2048 is yours. See how far you can go.</p><button class=\"ds-button\" type=\"button\">Keep playing</button><button class=\"ds-button ds-secondary\" type=\"button\">New Game</button></div></section>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;border:0;border-radius:8px;background:var(--button-bg,#252a25);color:var(--button-text,#fffdf6);font-size:12px;font-weight:700;padding:12px 17px;cursor:pointer;transition:background-color 160ms,transform 160ms cubic-bezier(.19,1,.22,1);font-family:Manrope,sans-serif;}.ds-button:hover{background:var(--button-hover,#424c39)}.ds-button:active{transform:translateY(1px)}.ds-button:focus-visible{outline:3px solid var(--focus,#566b24);outline-offset:5px}.ds-button:disabled{opacity:.5;cursor:default}.ds-button svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-overlay{display:grid;place-items:center;min-height:360px;text-align:center;padding:24px;border-radius:var(--radius,16px);background:var(--overlay-paper,rgb(245 243 235 / 96%));color:var(--ink,#252a25);font-family:Manrope,sans-serif;}.ds-milestone{width:90px;height:90px;display:grid;place-items:center;margin:0 auto 22px;border-radius:12px;font-size:28px;font-weight:800;background:#344a2a;color:#f1f5b0}.ds-overlay h2{font-size:32px;font-weight:700;letter-spacing:-.03em;margin:0 0 10px}.ds-overlay p{font-size:13px;color:var(--muted,#65695e);margin:0 0 24px}.ds-overlay .ds-button{min-height:48px;margin:4px}.ds-overlay .ds-secondary{background:var(--secondary-surface,#e0e5d3);color:var(--ink,#252a25)}.ds-overlay .ds-secondary:hover{background:var(--secondary-hover,#ccd8b0)}@media(max-width:400px){.ds-milestone{width:70px;height:70px;font-size:24px;margin-bottom:15px}.ds-overlay h2{font-size:27px}}"
    }
  ],
  "narrative": {
    "northStar": "Printed color-study swatch book",
    "overview": "Warm ivory stock, sharp dark Manrope, and solid numbered swatches make the puzzle feel like a printed color-study book. Quiet dividers and generous space let the working board lead. The color equation and square brand mark share its geometry.\n\nThe interface stays calm during repeated play: dark primary actions, small citrus feedback, tabular numbers, and progressive tile colors. Local typography, inline SVG, and CSS geometry provide the visual material; no raster illustration is required.\n\nA semantic dark palette preserves tile colors and dark numerals while adapting surfaces and controls. The header toggle replaces the help link; instructions stay below the board.",
    "keyCharacteristics": [
      "Warm paper and readable dark type.",
      "Progressive solid tile colors with visible numerals.",
      "A responsive square board and compact semantic controls.",
      "Flat tonal surfaces with softly rounded corners.",
      "Motion that explains slides, merges, and spawns."
    ],
    "rules": [
      {
        "name": "The Number First Rule",
        "body": "Color reinforces tile value; the visible numeral carries the game state.",
        "section": "colors"
      },
      {
        "name": "The Stable Numeral Rule",
        "body": "Use tabular numerals and reduce type size as digit counts grow so scores and tiles remain contained.",
        "section": "typography"
      },
      {
        "name": "The Paper Surface Rule",
        "body": "Separate surfaces with solid tonal fills and quiet borders. The shipped system has no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the actual paper, ink, and tile palette for new play states.",
      "Do preserve the square four-by-four board across supported widths.",
      "Do retain visible focus, semantic controls, and the screen-reader board table.",
      "Do resolve animation immediately when reduced motion is requested."
    ],
    "donts": [
      "Don't replace tile numbers with color-only meaning.",
      "Don't add gradients or shadows to the flat swatch surfaces.",
      "Don't allow controls or score numerals to force horizontal scrolling.",
      "Don't substitute decorative imagery for the established square geometry."
    ]
  }
}
